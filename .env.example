# Copy this file to .env and fill in real values. Never commit .env.

# Transcription and caption rewriting both run on OpenAI. This is the only AI key.
OPENAI_API_KEY=sk-your-openai-api-key

# Default model for the picker. gpt-transcribe is the most accurate on Thai, but it
# returns no timestamps, so cues are cut on silence (ffmpeg silencedetect) and timed
# from the cut points. whisper-1 is the only model that returns its own segment
# timings.
# TRANSCRIBE_MODEL=gpt-transcribe
# Extra model ids to offer in the UI's transcription model picker (comma-separated).
# OPENAI_TRANSCRIBE_MODELS=gpt-4o-transcribe-diarize
# Optional glossary/context hint passed to the transcription models.
# OPENAI_TRANSCRIBE_PROMPT=

# Chat model behind POST /api/videos/{id}/rewrite-captions (the optional LLM
# proofreader). The deterministic clean-up pass costs nothing and needs no model.
# REWRITE_MODEL=gpt-5

# Language code for transcription. The Thai word system and line splitter assume 'th'.
# TRANSCRIBE_LANGUAGE=th

# Override the built-in price list used for the time/cost estimate shown per run.
# USD per minute of audio for ASR, USD per 1M tokens for the rewrite model.
# Published prices move — set this if the estimate drifts from your bill.
# TRANSCRIBE_PRICING={"gpt-transcribe":{"per_minute":0.006,"realtime_factor":14}}

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be a real random secret in production — the app refuses to start
# with the placeholder value below when APP_ENV=production.
JWT_SECRET_KEY=change-me-in-production

# development | production. In production, JWT_SECRET_KEY must not be the
# placeholder value above, and FRONTEND_ORIGINS should be your real domain(s).
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:4287

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=borntodev_db

# Number of uvicorn worker processes for the backend.
WEB_CONCURRENCY=2

# Auto trim (cutting silence out of a video) runs in the auto-trim-rs service.
# docker-compose sets AUTO_TRIM_URL; set it here only when running the backend outside
# docker. Without it, the trim endpoints answer 503 instead of trimming differently.
# AUTO_TRIM_URL=http://localhost:8082
# Trims run as jobs now, so every call to the service is quick and this is only a
# safety net. Progress comes from polling, not from a long-held request.
# AUTO_TRIM_TIMEOUT=120
