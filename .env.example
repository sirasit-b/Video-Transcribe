# Copy this file to .env and fill in real values. Never commit .env.

# Transcription (whisper -> Gemini).
GEMINI_API_KEY=your-gemini-api-key
# Optional override; default is gemini-3.5-flash. Must support audio input AND JSON
# mode — the gemini-*-transcribe family does NOT (it rejects response_schema with 400).
# gemini-3.1-pro-preview works but needs a billing-enabled project; on a free-tier key
# it returns quota 0 / 429 on every request.
# GEMINI_TRANSCRIBE_MODEL=gemini-3.1-pro-preview
# Extra model ids to offer in the UI's transcription model picker (comma-separated).
# GEMINI_TRANSCRIBE_MODELS=gemini-2.5-flash,gemini-2.5-pro
# OPENAI_TRANSCRIBE_MODELS=gpt-4o-transcribe-diarize

# Default model for the picker, across providers. OpenAI ids are allowed here:
# gpt-transcribe is the most accurate on Thai, but it returns no timestamps, so cues
# are cut on silence (ffmpeg silencedetect) and timed from the cut points. whisper-1
# is the only OpenAI model that returns its own segment timings.
# TRANSCRIBE_MODEL=gpt-transcribe
# Optional glossary/context hint passed to the OpenAI transcription models.
# OPENAI_TRANSCRIBE_PROMPT=

# Used by POST /api/videos/{id}/rewrite-captions and by the OpenAI transcription models.
OPENAI_API_KEY=sk-your-openai-api-key

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be a real random secret in production — the app refuses to start
# with the placeholder value below when APP_ENV=production.
JWT_SECRET_KEY=change-me-in-production

# development | production. In production, JWT_SECRET_KEY must not be the
# placeholder value above, and FRONTEND_ORIGINS should be your real domain(s).
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:4287

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=borntodev_db

# Number of uvicorn worker processes for the backend.
WEB_CONCURRENCY=2
