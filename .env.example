# Copy this file to .env and fill in real values. Never commit .env.

OPENAI_API_KEY=sk-your-openai-api-key

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be a real random secret in production — the app refuses to start
# with the placeholder value below when APP_ENV=production.
JWT_SECRET_KEY=change-me-in-production

# development | production. In production, JWT_SECRET_KEY must not be the
# placeholder value above, and FRONTEND_ORIGINS should be your real domain(s).
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:4287

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=borntodev_db

# Number of uvicorn worker processes for the backend.
WEB_CONCURRENCY=2
